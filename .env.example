# ============================================================
# Dance Teacher Expo 2027 — environment variables (template)
# Copy to .env.local for development. Never commit real secrets —
# production/preview values live in Vercel + Supabase env settings.
# NEXT_PUBLIC_* values are exposed to the browser; everything else
# is server-only.
# ============================================================

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Root-domain cookie so Meta _fbp/_fbc carry across the GHL → tickets handoff.
NEXT_PUBLIC_COOKIE_DOMAIN=".danceteacherexpo.com.au"

# ---- Supabase (Sydney, ap-southeast-2) ----
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses RLS — used by the Stripe webhook (source of truth). Never expose.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Stripe (existing DTE account) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# From the webhook endpoint config; used to verify signatures.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Resend (transactional email: order confirmation, QR tickets) ----
# Sending domain is the updates.danceteacherexpo.com.au subdomain (kept separate
# from Google/GHL mail). Before the domain verifies you can test with the shared
# sender "Dance Teacher Expo <onboarding@resend.dev>" (delivers only to your own
# Resend account email).
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Dance Teacher Expo <tickets@updates.danceteacherexpo.com.au>"

# ---- Go High Level (marketing sync only: contact upsert + tags on purchase) ----
GHL_API_KEY="your-ghl-api-key"
GHL_LOCATION_ID="your-ghl-location-id"

# ---- Meta Conversions API (server-side, event_id dedup with the Pixel) ----
NEXT_PUBLIC_META_PIXEL_ID="your-pixel-id"
META_CAPI_ACCESS_TOKEN="your-capi-access-token"
# Optional: only while testing events in Meta Events Manager.
META_TEST_EVENT_CODE=""

# ============================================================
# Dance Teacher Expo 2027 — environment variables (template)
# Copy to .env.local for development. Never commit real secrets —
# production/preview values live in Vercel + Supabase env settings.
# NEXT_PUBLIC_* values are exposed to the browser; everything else
# is server-only.
# ============================================================

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Root-domain cookie so Meta _fbp/_fbc carry across the GHL → tickets handoff.
NEXT_PUBLIC_COOKIE_DOMAIN=".danceteacherexpo.com.au"

# ---- Supabase (Sydney, ap-southeast-2) ----
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses RLS — used by the Stripe webhook (source of truth). Never expose.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Stripe (existing DTE account) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# From the webhook endpoint config; used to verify signatures.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Resend (transactional email: order confirmation, QR tickets) ----
# Sending domain is the updates.danceteacherexpo.com.au subdomain (kept separate
# from Google/GHL mail). Before the domain verifies you can test with the shared
# sender "Dance Teacher Expo <onboarding@resend.dev>" (delivers only to your own
# Resend account email).
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Dance Teacher Expo <tickets@updates.danceteacherexpo.com.au>"
# Replies route here (the monitored GHL inbox), since the send subdomain isn't
# a reply-to inbox. Leave unset to send with no Reply-To header.
RESEND_REPLY_TO="hello@danceteacherexpo.com.au"

# ---- Go High Level (marketing sync only: contact upsert + tags on purchase) ----
# GHL_API_KEY is a LeadConnector v2 Private Integration token: in the DTE
# sub-account go Settings → Private Integrations → create one with the
# "Contacts: write/edit" scope. GHL_LOCATION_ID is the DTE sub-account id
# (currently lIHlSUSpyeM3oHq89UXV). Leave unset to skip GHL sync entirely.
GHL_API_KEY="your-ghl-private-integration-token"
GHL_LOCATION_ID="lIHlSUSpyeM3oHq89UXV"

# ---- Google Tag Manager (managed by Soup Agency) ----
# GTM owns GA4 (G-W9SGXSXVKM) and Google Ads events — the GA4 tag lives inside
# the container, so there is no hardcoded gtag.js. Leave unset to disable GTM.
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# ---- Meta Conversions API (server-side, event_id dedup with the Pixel) ----
# Pixel id is public (browser Pixel). CAPI token: Events Manager → Settings →
# Conversions API → Generate access token. Leave both unset to disable all
# Meta tracking (browser Pixel + server CAPI). Purchase dedups browser vs
# server on the order number; InitiateCheckout is server-only.
NEXT_PUBLIC_META_PIXEL_ID="your-pixel-id"
META_CAPI_ACCESS_TOKEN="your-capi-access-token"
# Optional: only while testing events in Meta Events Manager (Test Events tab).
META_TEST_EVENT_CODE=""

# ---- Admin access ----
# Comma-separated allowlist of emails that may sign into /admin (magic link).
# Empty/unset = nobody is admin (fails closed).
ADMIN_EMAILS="you@example.com"

# ---- Webhook / cron secrets (server-only shared secrets) ----
# Inbound GoHighLevel webhooks (vendor-deposit intake + inbound-message). Send
# it in the `x-webhook-secret` header. Unset = those endpoints 500 (fail closed).
GHL_INBOUND_SECRET="a-long-random-string"
# Supabase "send email" auth hook signing secret (Standard Webhooks).
SEND_EMAIL_HOOK_SECRET="v1,whsec_..."
# Guards the Vercel cron that keeps the Xero token alive. Set this in Vercel and
# it is auto-sent as `Authorization: Bearer` on cron calls. Unset = route 500s
# (fail closed) so it is never world-callable.
CRON_SECRET="a-long-random-string"

# ---- Xero (vendor deposit auto-invoicing; free Xero web app, OAuth2) ----
XERO_CLIENT_ID="your-xero-web-app-client-id"
XERO_CLIENT_SECRET="your-xero-web-app-client-secret"
# Optional: branding theme applied to generated invoices.
XERO_BRANDING_THEME_ID=""

# --- Ticket sales gate ---
# Master on-sale switch for the /tickets page. Unset or anything other than
# "true" = tickets are GATED (visitors see the waitlist instead of the buy
# flow). Set to "true" only when ready to sell (Stripe live keys in place).
TICKETS_ON_SALE="false"
